# Configuração do Experimento para LibrePhotos (Python + Docker + Py-Spy + RAPL)

TARGET_LANGUAGE=python
MODE=container
CONTAINER_NAME=backend

HOST=127.0.0.1
PORT=3000
BASE_URL=http://127.0.0.1:3000

# Escopo da Aplicação (Obrigatório para o analisador de energia)
APPLICATION_PREFIX=api,librephotos,service,image_similarity
PROJECT_ROOT=/code

# Configurações de Workload e Carga (k6)
WORKLOAD=librephotos
LIBREPHOTOS_USER=admin
LIBREPHOTOS_PASS=AdminPass123!
SCALE=1
RATE=5

# Janelas de Tempo (segundos)
DURATION_SECONDS=60
WARMUP_SECONDS=10
BASELINE_SECONDS=15
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5

# Configurações de Profiling e Hardware RAPL
PYSPY_RATE_HZ=100
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX="(python|python3|gunicorn|celery|postgres)"
SCAPHANDRE_MAX_PROCESSES=100

# Intensidade de Carbono da Matriz Elétrica Local (gCO2e / kWh)
CARBON_INTENSITY_G_PER_KWH=100
