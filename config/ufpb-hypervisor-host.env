# ==============================================================================
# Configuração de Experimento: Nó Físico / Hypervisor (Proxmox / KVM / Host) - STI UFPB
# ==============================================================================
# Use este modo no host físico de Data Center para medir o consumo total de hardware (RAPL)
# e discriminar o gasto elétrico por processo de virtualização (qemu/kvm/lxc/docker).

TARGET_LANGUAGE=process
MODE=process
# Monitora a árvore geral de virtualização ou processo raiz do hypervisor
PID=1

HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080

# Escopo geral da infraestrutura
APPLICATION_PREFIX=kvm,qemu,docker,containerd,lxc
PROJECT_ROOT=/

# Configurações de Workload e Carga (k6)
WORKLOAD=sigaa
SCALE=1
RATE=10

# Janelas de Tempo (segundos)
DURATION_SECONDS=180
WARMUP_SECONDS=15
BASELINE_SECONDS=30
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5

# Scaphandre monitora todos os processos do host físico
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX="(qemu|kvm|docker|containerd|java|postgres|nginx|php-fpm)"
SCAPHANDRE_MAX_PROCESSES=300

# Intensidade de Carbono da Matriz Elétrica Brasileira (SIN / Nordeste)
CARBON_INTENSITY_G_PER_KWH=61.7
