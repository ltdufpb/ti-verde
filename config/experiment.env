# Configurações do Medidor de Energia e Performance
#
# Este arquivo traz valores padrão para medir a aplicação de teste embutida
# (public/index.php). Para medir uma aplicação real, copie este arquivo
# (ex: config/producao.env) e ajuste TARGET_LANGUAGE, MODE,
# APPLICATION_PREFIX, PROJECT_ROOT e SCAPHANDRE_PROCESS_REGEX. Use com:
#   ./run-meter.sh --config config/producao.env

TARGET_LANGUAGE=php
MODE=local

HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080

# Filtro de escopo da aplicação (obrigatório em qualquer linguagem/modo).
# "public." isola as funções de public/index.php (a app de teste). Para uma
# aplicação real, troque pelo namespace/pacote/módulo dela (ex: "App\\",
# "com.empresa.sistema", "meuapp.").
APPLICATION_PREFIX=public.
PROJECT_ROOT=.

# Configurações de Workload e Carga (k6) — usado apenas com o k6.js sintético
WORKLOAD=mixed
SCALE=1
RATE=2

# Janelas de Tempo (segundos)
DURATION_SECONDS=60
WARMUP_SECONDS=10
BASELINE_SECONDS=15
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5

# Configurações de Profiling e Hardware RAPL
PHPSPY_RATE_HZ=99
PYSPY_RATE_HZ=100
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX="(php|mysqld|mariadbd|apache2)"
SCAPHANDRE_MAX_PROCESSES=100

# Intensidade de Carbono da Matriz Elétrica Local (gCO2e / kWh)
CARBON_INTENSITY_G_PER_KWH=100
