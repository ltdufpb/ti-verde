# Green PHP Lab measurement configuration

HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080

WORKLOAD=mixed
SCALE=1

# Deixe o RATE em 2 para que o experimento seja executado por 60 segundos, com 10 segundos de aquecimento, 15 segundos de baseline, 3 segundos de coleta 
# antes do experimento e 5 segundos de coleta após o experimento, e 30 segundos de cooldown. Isso garante que a medição seja feita sem iterações descartadas.    
RATE=2
DURATION_SECONDS=60
WARMUP_SECONDS=10
BASELINE_SECONDS=15
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5
COOLDOWN_SECONDS=30

PHPSPY_RATE_HZ=99
PYSPY_RATE_HZ=100
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX=php
SCAPHANDRE_MAX_PROCESSES=100

# Apenas para fins de demonstração, tem que substituir antes de reportar resultados de carbon.
CARBON_INTENSITY_G_PER_KWH=100
