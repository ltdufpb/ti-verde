# ==============================================================================
# Configuração de Experimento: Portal Institucional (PHP / WordPress / Nginx) - STI UFPB
# ==============================================================================

TARGET_LANGUAGE=php
MODE=container
CONTAINER_NAME=ufpb_portal_php

HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080

# Escopo da Aplicação (Filtro multi-prefixo para classes, plugins e temas da UFPB)
APPLICATION_PREFIX=UFPB\\,App\\,Theme\\,WordPress\\,wp_
PROJECT_ROOT=/var/www/html

# Configurações de Workload e Carga (k6)
WORKLOAD=ufpb-portal
UFPB_USER=editor_portal
UFPB_PASS=PortalPass123!
SCALE=1
RATE=15

# Janelas de Tempo (segundos)
DURATION_SECONDS=60
WARMUP_SECONDS=10
BASELINE_SECONDS=15
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5

# Profiling PHP (phpspy) e Scaphandre
PHPSPY_RATE_HZ=99
PHPSPY_THREADS=16
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX="(php|php-fpm|nginx|apache2|mysqld|mariadbd)"
SCAPHANDRE_MAX_PROCESSES=100

# Intensidade de Carbono da Matriz Elétrica Brasileira (SIN / Nordeste)
CARBON_INTENSITY_G_PER_KWH=61.7
