# ==============================================================================
# Configuração de Experimento: APIs / Microsserviços Python (FastAPI / Django) - STI UFPB
# ==============================================================================

TARGET_LANGUAGE=python
MODE=container
CONTAINER_NAME=ufpb_api_backend

HOST=127.0.0.1
PORT=8000
BASE_URL=http://127.0.0.1:8000

# Escopo da Aplicação (Módulos de negócio da STI / UFPB)
APPLICATION_PREFIX=api,core,services,autenticacao,ufpb,sti
PROJECT_ROOT=/app

# Configurações de Workload e Carga (k6)
WORKLOAD=ufpb-api
UFPB_USER=api_user
UFPB_PASS=ApiPass123!
SCALE=1
RATE=20

# Janelas de Tempo (segundos)
DURATION_SECONDS=60
WARMUP_SECONDS=10
BASELINE_SECONDS=15
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5

# Profiling Py-Spy e Scaphandre
PYSPY_RATE_HZ=100
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX="(python|python3|gunicorn|uvicorn|postgres|redis)"
SCAPHANDRE_MAX_PROCESSES=100

# Intensidade de Carbono da Matriz Elétrica Brasileira (SIN / Nordeste)
CARBON_INTENSITY_G_PER_KWH=61.7
