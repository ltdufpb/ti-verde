# ==============================================================================
# Configuração de Experimento: SIGAA (Java / Tomcat / JVM / PostgreSQL) - STI UFPB
# ==============================================================================

TARGET_LANGUAGE=java
MODE=container
CONTAINER_NAME=sigaa_backend

HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080

# Escopo da Aplicação (Filtro multi-prefixo para pacotes de negócio do SIGAA/UFPB)
APPLICATION_PREFIX=br.ufpb,br.ufrn.sigaa,br.ufrn.arq,br.ufrn.comum,br.ufpb.sigaa
PROJECT_ROOT=/opt/sigaa

# Configurações de Workload e Carga (k6)
WORKLOAD=sigaa
SIGAA_USER=discente_teste
SIGAA_PASS=DiscentePass123!
SCALE=1
RATE=10

# Janelas de Tempo (segundos)
DURATION_SECONDS=120
WARMUP_SECONDS=15
BASELINE_SECONDS=20
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5

# Monitoramento de Processos (Java / Tomcat / PostgreSQL / WildFly)
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX="(java|jvm|postgres|postmaster|tomcat|catalina|wildfly)"
SCAPHANDRE_MAX_PROCESSES=150

# Intensidade de Carbono da Matriz Elétrica Brasileira (SIN / Nordeste)
# Referência média ONS/MCTI: ~61.7 gCO2e / kWh
CARBON_INTENSITY_G_PER_KWH=61.7
