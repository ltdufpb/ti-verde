# Green PHP Lab measurement configuration
#
# Replace CARBON_INTENSITY_G_PER_KWH with an official value for the place
# and period where the experiment is performed.

HOST=127.0.0.1
PORT=8080
BASE_URL=http://127.0.0.1:8080

WORKLOAD=mixed
SCALE=1

# Keep this low enough that BOTH implementations complete the scheduled load
# without dropped iterations.
RATE=2
DURATION_SECONDS=60
WARMUP_SECONDS=10
BASELINE_SECONDS=15
COLLECTOR_LEAD_SECONDS=3
COLLECTOR_TAIL_SECONDS=5
COOLDOWN_SECONDS=30

PHPSPY_RATE_HZ=99
SCAPHANDRE_STEP_SECONDS=1
SCAPHANDRE_PROCESS_REGEX=php
SCAPHANDRE_MAX_PROCESSES=100

# Demonstration placeholder only. Replace before reporting carbon results.
CARBON_INTENSITY_G_PER_KWH=100
